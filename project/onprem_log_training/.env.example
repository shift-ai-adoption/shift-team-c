# onprem_log_training 環境変数サンプル
# 使い方: cp .env.example .env して値を編集する

# --- プロキシ切替 ---
# true にすると HTTP_PROXY/HTTPS_PROXY/NO_PROXY を有効化する。false なら無効化(プロキシ不要な環境向け)。
USE_PROXY=false
HTTP_PROXY=http://proxy.example.internal:8080
HTTPS_PROXY=http://proxy.example.internal:8080
NO_PROXY=localhost,127.0.0.1

# --- client/server 接続設定 ---
SERVER_BASE_URL=http://localhost:4002
PORT=3002

# --- server (function tier) 設定 ---
SERVER_PORT=4002

# --- docker/setup-containers.sh 用 ---
SSH_PORT=5101
SERVER_HTTP_PORT=4002

# --- docker-compose (client コンテナ) 用 ---
# ホスト側で公開するclientのHTTPポート。ブラウザから http://localhost:<この値>/ でアクセスする。
CLIENT_HTTP_PORT=3002
# client イメージは apk 等の追加パッケージが不要なため、オンプレのdocker.io/npmホワイトリスト内で
# そのままローカルビルドできる(server と異なり Docker Hub 経由のpull運用は不要)。
CLIENT_DOCKER_IMAGE=onprem-log-training-client:latest

# docker.io (Docker Hub) 上のイメージパスをフルパスで指定する。
# オンプレ側で docker pull する際、レジストリ選択の余地がないようにするため。
# your-dockerhub-username は実際に push した Docker Hub のユーザー名/組織名に置き換える
# (この行は `source` されるため <> は使わないこと)。
DOCKER_IMAGE=docker.io/your-dockerhub-username/onprem-log-training-server:latest
